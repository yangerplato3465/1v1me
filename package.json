{
  "name": "1v1me",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "happy-dom": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
